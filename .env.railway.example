# BadBlue Railway Deployment Environment Variables
# Copy this to Railway dashboard environment settings

# ===========================================
# SUPABASE CONFIGURATION (Required)
# ===========================================
SUPABASE_URL=https://your-project.supabase.co
LEGALWHAT_AUTH_SUPABASE_URL=https://your-auth-project.supabase.co
LEGALWHAT_EDGE_AUTH_SECRET=
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-key-here
SUPABASE_DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Optional alternate alias for the same pooled Postgres connection string.
# SUPABASE_DB_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Do not set DATABASE_URL to https://<project>.supabase.co.
# DATABASE_URL=

# ===========================================
# DATABASE SESSION / CRYPTOCRAWLER COORDINATION
# ===========================================
# CryptoCrawler nonce/signer/rate coordination requires PostgreSQL session
# semantics. Use a direct connection or Supavisor session-mode connection.
# NEVER point CRYPTOCRAWL_COORDINATION_DATABASE_URL at transaction-pooler port 6543;
# transaction pooling cannot preserve the session advisory locks used for
# cross-replica nonce/signing ownership. If SUPABASE_DATABASE_URL is already a
# direct/session-capable :5432 connection, this variable may be left empty and the
# runtime will reuse the canonical database URL through its dedicated small pool.
CRYPTOCRAWL_COORDINATION_DATABASE_URL=
CRYPTOCRAWL_COORDINATION_POOL_MAX=2
CRYPTOCRAWL_COORDINATION_CONNECTION_TIMEOUT_MS=5000
CRYPTOCRAWL_COORDINATION_IDLE_TIMEOUT_MS=10000

# Session-mode capacity budget. Defaults below are intentionally conservative for
# the observed 15-session Supavisor ceiling and overlapping Railway deployments.
# The rollout coordinator accounts for ordinary app sessions + both replicas'
# coordination pools + a control-plane reserve before restoring steady capacity.
BADBLUE_DATABASE_SESSION_POOL_LIMIT=15
BADBLUE_DATABASE_SESSION_RESERVE=2
BADBLUE_DATABASE_POOL_MAX=6
BADBLUE_DATABASE_ROLLOUT_POOL_MAX=3
BADBLUE_DATABASE_ROLLOUT_HEADROOM_MS=90000

# Bounded distributed-lock/rate waits. Failure remains fail-closed; these do not
# authorize execution or weaken nonce/order/rate safety.
CRYPTO_KRAKEN_LOCK_ACQUIRE_TIMEOUT_MS=6000
CRYPTO_EVM_SIGNER_LOCK_TIMEOUT_MS=6000
CRYPTO_OKX_DISTRIBUTED_RATE_LOCK_TIMEOUT_MS=7500
CRYPTO_OKX_REPLICA_SAFETY_FACTOR=4

# ===========================================
# MIGRATION FEATURE FLAGS
# ===========================================
# Enable these gradually during migration
USE_SUPABASE_DB=false
USE_SUPABASE_AUTH=false
USE_SUPABASE_STORAGE=false

# ===========================================
# AI SERVICE CONFIGURATION (Required)
# ===========================================
# Primary AI (50% usage)
MISTRAL_API_KEY=your-mistral-api-key

# Secondary AI (30-35% usage)
GROQ_API_KEY=your-groq-api-key

# Tertiary AI (10% usage)
GEMINI_API_KEY=your-gemini-api-key

# Quaternary AI (5-10% usage)
ANTHROPIC_API_KEY=your-anthropic-api-key

# ===========================================
# PAYMENT PROCESSING (Required by production startup)
# ===========================================
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_APPLICATION_ID=
SQUARE_ENVIRONMENT=production
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_SUBSCRIPTION_PLAN_VARIATION_ID=

# ===========================================
# EMAIL SERVICE (Required)
# ===========================================
RESEND_API_KEY=re_your-resend-api-key

# ===========================================
# PLATFORM ADMINISTRATION
# ===========================================
# Required for the PANTHEON Administrator master login. Set both only in Railway.
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=

# Optional separate admin bypass for legacy operational access.
ADMIN_BYPASS_ID=
ADMIN_BYPASS_EMAIL=
ADMIN_BYPASS_PASSWORD=

# ===========================================
# ELEVENLABS VOICE SYNTHESIS (Required for Lexara TTS)
# ===========================================
# Sign up at https://elevenlabs.io/ for API access
# IMPORTANT: Use your ElevenLabs API Key, NOT any 2FA recovery code
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-voice-id

# ===========================================
# SPECTRA OPTIONAL DATA SOURCES
# ===========================================
# Nationwide traffic-camera metadata/images when licensed/configured.
TRAFFICLAND_API_KEY=
TRAFFICLAND_SYSTEM=

# Additional state/local ArcGIS camera layers:
# https://.../FeatureServer/0|Provider Name,https://.../FeatureServer/0|Provider Name
SPECTRA_CAMERA_ARCGIS_FEEDS=

# Optional vendor camera-directory JSON feeds. This is also the adapter slot
# for WorldCam-style/global camera directories when a usable JSON endpoint is
# available. Supports URL templates using {{lat}}, {{lng}}, and {{radiusMiles}}
# plus field mappings and auth headers referenced by environment-variable name.
SPECTRA_CAMERA_JSON_FEEDS=[]

# Optional public geotagged-photo expansion.
FLICKR_API_KEY=

# Cell-position fallback for supplied MCC/MNC/LAC/TAC/cell IDs.
OPENCELLID_API_KEY=

# Optional nearby-place enrichment.
GEONAMES_USERNAME=

# Signed external telemetry webhook key. Providers sign
# "<ISO timestamp>.<canonical JSON body>" with HMAC-SHA256.
SPECTRA_TELEMETRY_HMAC_SECRET=

# Optional managed-device location backends. These endpoints are expected to
# expose the latest location already available through the organization's
# Android EMM / Apple MDM deployment; SPECTRA does not put devices into Lost Mode.
SPECTRA_ANDROID_MDM_LOCATION_URL_TEMPLATE=
SPECTRA_ANDROID_MDM_LOCATION_TOKEN=
SPECTRA_ANDROID_MDM_LOCATION_TIMEOUT_MS=7000
SPECTRA_APPLE_MDM_LOCATION_URL_TEMPLATE=
SPECTRA_APPLE_MDM_LOCATION_TOKEN=
SPECTRA_APPLE_MDM_LOCATION_TIMEOUT_MS=7000

# Optional Cisco Spaces active-device REST adapter. Keep the provider URL fixed
# and use {{deviceRef}} in the path/query where the tenant API expects a device ID.
SPECTRA_CISCO_SPACES_DEVICE_URL_TEMPLATE=
SPECTRA_CISCO_SPACES_TOKEN=
SPECTRA_CISCO_SPACES_TIMEOUT_MS=7000

# Optional active provider/device collectors for enrolled or managed devices.
# JSON array. Each entry supplies: id, label, fixed HTTPS url, method GET|POST,
# normalizerKind, target (device|none), optional headersFromEnv/queryFromEnv,
# and optional timeoutMs.
# Existing normalizerKind values include android-radio-collector,
# android-ranging-manager, android-raw-gnss, android-cellular,
# apple-nearby-interaction, cisco-spaces-location, arcore-geospatial-pose,
# owntracks-location, chirpstack-location, find3-location,
# espresense-observation, kismet-device-location, openwisp-wifi-session,
# traccar-position, meshtastic-position, cot-location,
# homeassistant-device-tracker, or canonical-telemetry when the collector already returns
# SPECTRA measurements.
SPECTRA_ACTIVE_PROVIDER_ADAPTERS=[]

# Optional built-in open-source acquisition bridges. URL templates may use
# {{deviceRef}} and {{sessionId}}. Leave unset unless the corresponding service
# is actually deployed and reachable over HTTPS.
SPECTRA_FIND3_LOCATION_URL_TEMPLATE=
SPECTRA_FIND3_TIMEOUT_MS=7000
SPECTRA_TRACCAR_POSITION_URL_TEMPLATE=
SPECTRA_TRACCAR_AUTHORIZATION=
SPECTRA_TRACCAR_TIMEOUT_MS=7000
SPECTRA_KISMET_DEVICE_URL_TEMPLATE=
SPECTRA_KISMET_API_KEY=
SPECTRA_KISMET_TIMEOUT_MS=7000
SPECTRA_OPENWISP_WIFI_SESSIONS_URL_TEMPLATE=
SPECTRA_OPENWISP_AUTHORIZATION=
SPECTRA_OPENWISP_TIMEOUT_MS=7000
SPECTRA_OWNTRACKS_LOCATION_URL_TEMPLATE=
SPECTRA_OWNTRACKS_AUTHORIZATION=
SPECTRA_OWNTRACKS_TIMEOUT_MS=7000

# Optional Home Assistant REST device_tracker/person state bridge.
# Use an HTTPS state endpoint template, e.g. your own HA reverse-proxy URL ending
# in /api/states/{{deviceRef}}. The token stays in Railway and is sent as Bearer.
SPECTRA_HOME_ASSISTANT_STATE_URL_TEMPLATE=
SPECTRA_HOME_ASSISTANT_TOKEN=
SPECTRA_HOME_ASSISTANT_TIMEOUT_MS=7000

# Optional Hootenanny map-conflation service. SPECTRA queries the configured
# conflated map for bounded road/building/POI context and can submit explicit
# conflation jobs through Hootenanny's service API.
SPECTRA_HOOTENANNY_BASE_URL=
SPECTRA_HOOTENANNY_MAP_ID=
# If Hootenanny requires bearer auth, set this to the NAME of the Railway
# variable holding that token, not the token itself.
SPECTRA_HOOTENANNY_TOKEN_ENV=

# Provider-neutral authenticated infrastructure webhook configuration.
# JSON entries may use:
# {"providerId":"mist-site-a","mode":"mist-hmac-sha256","secretEnv":"MIST_WEBHOOK_SECRET"}
# or a static header token:
# {"providerId":"extreme-site-a","header":"authorization","tokenEnv":"EXTREME_WEBHOOK_TOKEN"}
# Native Meraki Scanning API receiver:
# {"providerId":"meraki-site-a","mode":"meraki-scanning-secret","secretEnv":"MERAKI_SCANNING_SECRET","validatorEnv":"MERAKI_SCANNING_VALIDATOR","sessionId":"spectra-...","subjectLabel":"Target"}
# A matching SPECTRA_PROVIDER_SESSION_BINDINGS entry is still required before
# provider telemetry can append to an already-owned user session.
SPECTRA_INFRASTRUCTURE_WEBHOOK_AUTH=[]

# Explicit provider-to-owned-session authorization. A pre-authenticated provider
# may append telemetry to an already-owned SPECTRA session only when a matching
# binding is present. tenantId is required for provider writes and pins the binding
# to that authenticated user tenant.
# Example: [{"providerId":"mist-site-a","sessionId":"spectra-...","tenantId":"user-id"}]
SPECTRA_PROVIDER_SESSION_BINDINGS=[]

# Provider-neutral WSS location streams. Each entry may specify id, label, wss URL,
# decoder (json|cot-xml|aruba-location-protobuf), normalizerKind, optional sessionId and
# subjectLabel, auth environment names, reconnect/heartbeat bounds, and up to 8 bounded
# openMessages sent after every successful connect/reconnect.
# OAuth client credentials are refreshed automatically.
# omlox example:
# [{"id":"omlox-hub-a","label":"omlox Hub A","url":"wss://hub.example/v2/ws/socket","decoder":"json","normalizerKind":"omlox-location","openMessages":[{"event":"subscribe","topic":"location_updates","params":{"crs":"EPSG:4326"}}]}]
SPECTRA_WSS_PROVIDER_ADAPTERS=[]

# Provider-neutral MQTT-over-TLS streams for RUCKUS/open-source/managed
# infrastructure. Each entry supplies id, brokerUrl (mqtts://), topic,
# decoder (json|cot-xml), normalizerKind, optional sessionId/subjectLabel,
# and optional username/password
# environment-variable names.
SPECTRA_MQTT_PROVIDER_ADAPTERS=[]

# Optional UniFi official API pull adapter.
SPECTRA_UNIFI_CLIENT_URL_TEMPLATE=
SPECTRA_UNIFI_API_KEY=
SPECTRA_UNIFI_TIMEOUT_MS=7000

# Floorplan calibration and identity binding used by Mist/Aruba/Extreme/etc.
SPECTRA_FLOORPLAN_CALIBRATIONS_JSON=[]
SPECTRA_INFRASTRUCTURE_SUBJECT_BINDINGS=[]

# Cross-replica acquisition governance. PostgreSQL advisory locks enforce these
# concurrency ceilings; a bounded local fallback remains available if the database
# cannot grant advisory locks.
SPECTRA_MAX_CONCURRENT_ACQUISITIONS=4
SPECTRA_MAX_CONCURRENT_ACQUISITIONS_PER_TENANT=2
SPECTRA_RESOURCE_ACQUIRE_TIMEOUT_MS=1500
# Keep false in production so loss of the shared Postgres governor fails closed
# instead of silently becoming per-replica governance.
SPECTRA_ALLOW_LOCAL_GOVERNOR_FALLBACK=false

# Optional known-anchor catalog for managed Wi-Fi/UWB/Bluetooth infrastructure.
# JSON array entries may use id/anchorId/deviceId/macAddress/bssid/beaconId plus
# latitude, longitude, optional altitude, accuracyMeters, aliases, kind, metadata.
SPECTRA_ANCHOR_CATALOG_JSON=[]

# Google radio positioning for supplied Wi-Fi/cellular measurements.
SPECTRA_GOOGLE_GEOLOCATION_API_KEY=

# Optional pull-only JSON provider adapters. This is a JSON array of fixed HTTPS
# endpoints and field mappings; header values are referenced by environment-variable
# name rather than embedded in this value. Vehicle/camera feeds may additionally map
# trackIdPath, cameraIdPath, objectClassPath, speedPath and headingPath.
SPECTRA_GENERIC_JSON_ADAPTERS=[]

# Optional geocoder override. Defaults to OpenStreetMap Nominatim.
SPECTRA_GEOCODER_BASE_URL=

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
NODE_ENV=production
BASE_URL=

# Generate a unique 32+ character value and set it only in Railway.
SESSION_SECRET=

# ===========================================
# CRYPTOCRAWLER MONITORING (Optional)
# ===========================================
# Canonical ordinary chain access is the free/configured provider mesh. PublicNode,
# dRPC and official public chain endpoints are no-key alternatives; configured
# providers remain route-local alternatives rather than prerequisites.
CRYPTOCRAWL_COST_SAFE_PUBLIC_RPC_ENABLED=true
CRYPTOCRAWL_FREE_STREAMING_RPC_ENABLED=true
CRYPTOCRAWL_PROVIDER_MESH_MEMPOOL_ENABLED=true
CRYPTOCRAWL_MEMPOOL_NETWORKS=ethereum,polygon
CRYPTOCRAWL_MEMPOOL_PRESSURE_NETWORKS=ethereum,polygon
CRYPTOCRAWL_MEMPOOL_PRESSURE_TTL_MS=15000
CRYPTOCRAWL_MEMPOOL_PRESSURE_TIMEOUT_MS=1800
CRYPTOCRAWL_PENDING_CACHE_TTL_MS=60000
CRYPTOCRAWL_PENDING_MAX_CACHE=2000
CRYPTOCRAWL_PENDING_MAX_DETAILS_PER_MINUTE=120
CRYPTOCRAWL_PENDING_RECONNECT_MS=5000
# Optional JSON array of additional RPC providers. Each entry may include provider,
# chain, httpUrl, websocketUrl, priority and pendingTransactions.
CRYPTOCRAWL_RPC_PROVIDER_MESH=

# Optional named provider endpoints. They are admitted only when explicitly set.
ETHEREUM_CHAINSTACK_RPC_URL=
ETHEREUM_CHAINSTACK_WS_URL=
ETHEREUM_GETBLOCK_RPC_URL=
ETHEREUM_GETBLOCK_WS_URL=
ETHEREUM_DRPC_RPC_URL=
ETHEREUM_DRPC_WS_URL=
ETHEREUM_BLAST_RPC_URL=
ETHEREUM_BLAST_WS_URL=
POLYGON_CHAINSTACK_RPC_URL=
POLYGON_CHAINSTACK_WS_URL=
POLYGON_GETBLOCK_RPC_URL=
POLYGON_GETBLOCK_WS_URL=
POLYGON_DRPC_RPC_URL=
POLYGON_DRPC_WS_URL=
POLYGON_BLAST_RPC_URL=
POLYGON_BLAST_WS_URL=

COINGECKO_API_KEY=
COINSTATS_API_KEY=
ZEROX_API_KEY=
ZEROX_TAKER_ADDRESS=
# Optional 0x route overrides/test knobs. Runtime telemetry can probe 0x without them;
# opportunity execution should derive route context dynamically from the live candidate.
ZEROX_CHAIN_ID=
ZEROX_SELL_TOKEN=
ZEROX_BUY_TOKEN=
ZEROX_SELL_AMOUNT=
# Kraken may retain an explicit configured compatibility override. Coinbase/OKX
# live execution must not treat configured fee numbers as a substitute for their
# authenticated fee/instrument evidence.
CRYPTO_ARBITRAGE_COINBASE_TAKER_FEE_BPS=
CRYPTO_ARBITRAGE_KRAKEN_TAKER_FEE_BPS=
CRYPTO_ARBITRAGE_OKX_TAKER_FEE_BPS=

# Broad measured discovery. Public-venue snapshots are batched, while authenticated
# executable evaluation remains bounded by the private CEX worker pool.
CRYPTO_MARKET_UNIVERSE_SIZE=120
CRYPTO_ARBITRAGE_MIN_SYMBOLS=12
CRYPTO_ARBITRAGE_BASE_SYMBOLS=24
CRYPTO_ARBITRAGE_MAX_SYMBOLS=96
CRYPTO_ARBITRAGE_SCAN_CONCURRENCY=6
CRYPTOCRAWL_SCAN_INTERVAL_MIN_MS=2000
CRYPTOCRAWL_SCAN_INTERVAL_BASE_MS=5000
CRYPTOCRAWL_SCAN_INTERVAL_MAX_MS=15000
CRYPTO_REQUIRE_LIVE_CONNECTORS=true
CRYPTARA_REQUIRE_LIVE_SIGNALS=true
TRADINGVIEW_LIVE_ENABLED=true

ETHEREUM_RPC_URL=
POLYGON_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
BSC_RPC_URL=
AVALANCHE_RPC_URL=

# Optional explicit Ankr endpoints. Configured endpoints may be admitted normally.
# Anonymous public Ankr fallback is fail-closed by default and must be explicitly
# enabled with CRYPTOCRAWL_ALLOW_PUBLIC_ANKR_FALLBACK=true when intentionally used.
ETHEREUM_ANKR_RPC_URL=
POLYGON_ANKR_RPC_URL=
ARBITRUM_ANKR_RPC_URL=
OPTIMISM_ANKR_RPC_URL=
BASE_ANKR_RPC_URL=
BSC_ANKR_RPC_URL=
AVALANCHE_ANKR_RPC_URL=
CRYPTOCRAWL_ALLOW_PUBLIC_ANKR_FALLBACK=false

PRIVATE_RPC_URL=
RPC_URL=
# Canonical operational CryptoCrawler signer. Its EVM address is derived at runtime
# and is reused for bridge depositor/recipient identity and retained trading profits.
WALLET_PRIVATE_KEY=
FLASHBOTS_AUTH_KEY=
FLASHBOTS_RPC=
BLOXROUTE_RPC=

# Normal authorized production posture: leave the emergency master stop disabled.
# RiskGovernor, Cryptara, verified all-in economics, circuit breakers and settlement
# verification remain responsible for rejecting unsafe/negative candidates.
NO_EXECUTION=false
CRYPTO_ARBITRAGE_LIVE_EXECUTION=false
CRYPTO_ARBITRAGE_LIVE_CONFIRMATION=
CRYPTO_ALLOW_PLACEHOLDER_EXECUTION=false

# Profit admission is non-configurable: complete measured all-in net profit must be > 0.
ZERO_CAPITAL_ENABLE_EXECUTION=false
ZERO_CAPITAL_FLASHLOAN_RECEIVER=
ZERO_CAPITAL_EXECUTION_CONFIRMATION=
ZERO_CAPITAL_ROUTE_MIN_OUTPUT_BPS=9990
ZERO_CAPITAL_ROUTE_TTL_MS=3000
ZERO_CAPITAL_MAX_GAS_LIMIT=1500000
ZERO_CAPITAL_MAX_SLIPPAGE_BPS=20
ZERO_CAPITAL_MAX_GAS_GWEI=60
ZERO_CAPITAL_MAX_QUOTE_LATENCY_MS=1000
ZERO_CAPITAL_SIGNAL_RECHECK_MS=5000
ZERO_CAPITAL_FLASHBOTS_FEE_BUFFER_BPS=12000
ZERO_CAPITAL_FLASHBOTS_MAX_FEE_GWEI=60
ZERO_CAPITAL_FLASHBOTS_PRIORITY_FEE_GWEI=1
ZERO_CAPITAL_FLASHBOTS_MAX_PRIORITY_FEE_GWEI=3
ZERO_CAPITAL_FLASHBOTS_WAIT_TIMEOUT_MS=45000
ZERO_CAPITAL_FLASHBOTS_PAYMENT_MODE=disabled
ZERO_CAPITAL_FLASHBOTS_SPONSOR_ADDRESS=
ZERO_CAPITAL_FLASHBOTS_SPONSOR_CONFIRMATION=
ZERO_CAPITAL_ROUTE_CONFIG=[]
ZERO_CAPITAL_DEPLOY_CHAIN=
ZERO_CAPITAL_DEPLOY_RPC_URL=
ZERO_CAPITAL_DEPLOY_OWNER=
ZERO_CAPITAL_BALANCER_VAULT=
ZERO_CAPITAL_DEPLOY=false
ZERO_CAPITAL_DEPLOY_CONFIRMATION=
ZERO_CAPITAL_RECEIVER_CONFIG={"operators":[],"targets":[],"approvalTokens":[]}
ZERO_CAPITAL_CONFIGURE_RECEIVER=false
ZERO_CAPITAL_CONFIGURE_RECEIVER_CONFIRMATION=

KRAKEN_API_KEY=
KRAKEN_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Coinbase Advanced Trade / CDP. The API key name is normally the full
# organizations/{org_id}/apiKeys/{key_id} identifier. Railway may store a PEM
# private key on one line with literal \n escapes; runtime normalizes them.
# Coinbase taker/IOC capability is implemented through Advanced Trade, but live
# execution remains fail-closed unless authenticated canView/canTrade permissions,
# authenticated SPOT fee evidence, measured product constraints/depth, reconciled
# inventory, settlement verification, governance, and live confirmation all pass.
COINBASE_API_KEY=
COINBASE_API_SECRET=

# Final external wallet used only when the independent terminal treasury sweeper
# cashes out after a verified terminal shutdown. Normal runtime profits do NOT go here.
CRYPTO_PROFIT_WALLET_ADDRESS=

# Legacy compatibility only. Do not configure these for a new deployment.
# Runtime repairs the bridge/Across depositor aliases in-process to the address
# derived from WALLET_PRIVATE_KEY, so they cannot represent a second wallet.
# BRIDGE_WALLET_ADDRESS=
# CRYPTOCRAWL_ACROSS_DEPOSITOR_ADDRESS=
# BRIDGE_SIGNER_PRIVATE_KEY=  # deprecated duplicate signer; remove from Railway
# WALLET_PUBLIC_KEY=          # unused/deprecated; remove from Railway

# ===========================================
# RAILWAY AUTO-POPULATED (Don't set manually)
# ===========================================
# RAILWAY_ENVIRONMENT=production
# RAILWAY_PROJECT_ID=auto-populated
