# BadBlue Railway Deployment Environment Variables
# Copy this to Railway dashboard environment settings

# ===========================================
# SUPABASE CONFIGURATION (Required)
# ===========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-key-here
SUPABASE_DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Optional alternate alias for the same pooled Postgres connection string.
# SUPABASE_DB_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Do not set DATABASE_URL to https://<project>.supabase.co.
# DATABASE_URL=

# ===========================================
# MIGRATION FEATURE FLAGS
# ===========================================
# Enable these gradually during migration
USE_SUPABASE_DB=false
USE_SUPABASE_AUTH=false
USE_SUPABASE_STORAGE=false

# ===========================================
# AI SERVICE CONFIGURATION (Required)
# ===========================================
# Primary AI (50% usage)
MISTRAL_API_KEY=your-mistral-api-key

# Secondary AI (30-35% usage)
GROQ_API_KEY=your-groq-api-key

# Tertiary AI (10% usage)
GEMINI_API_KEY=your-gemini-api-key

# Quaternary AI (5-10% usage)
ANTHROPIC_API_KEY=your-anthropic-api-key

# ===========================================
# PAYMENT PROCESSING (Required by production startup)
# ===========================================
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_APPLICATION_ID=
SQUARE_ENVIRONMENT=production

# ===========================================
# EMAIL SERVICE (Required)
# ===========================================
RESEND_API_KEY=re_your-resend-api-key

# ===========================================
# PLATFORM ADMINISTRATION
# ===========================================
# Required for the PANTHEON Administrator master login. Set both only in Railway.
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=

# Optional separate admin bypass for legacy operational access.
ADMIN_BYPASS_ID=
ADMIN_BYPASS_EMAIL=
ADMIN_BYPASS_PASSWORD=

# ===========================================
# ELEVENLABS VOICE SYNTHESIS (Required for Lexara TTS)
# ===========================================
# Sign up at https://elevenlabs.io/ for API access
# IMPORTANT: Use your ElevenLabs API Key, NOT any 2FA recovery code
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-voice-id

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
NODE_ENV=production
BASE_URL=

# Generate a unique 32+ character value and set it only in Railway.
SESSION_SECRET=

# ===========================================
# CRYPTOCRAWLER MONITORING (Optional)
# ===========================================
# Use authenticated, rate-limited RPC endpoints for production monitoring.
ALCHEMY_API_KEY=
COINGECKO_API_KEY=
COINSTATS_API_KEY=
ZEROX_API_KEY=
ZEROX_TAKER_ADDRESS=
CRYPTO_ARBITRAGE_COINBASE_TAKER_FEE_BPS=
CRYPTO_ARBITRAGE_KRAKEN_TAKER_FEE_BPS=
CRYPTO_ARBITRAGE_OKX_TAKER_FEE_BPS=
CRYPTO_MARKET_UNIVERSE_SIZE=12
CRYPTO_ARBITRAGE_MAX_SYMBOLS=4
CRYPTO_REQUIRE_LIVE_CONNECTORS=true
CRYPTARA_REQUIRE_LIVE_SIGNALS=true
ALCHEMY_REQUIRE_LIVE=true
TRADINGVIEW_LIVE_ENABLED=true

ETHEREUM_RPC_URL=
POLYGON_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
BSC_RPC_URL=
AVALANCHE_RPC_URL=

PRIVATE_RPC_URL=
RPC_URL=
WALLET_PRIVATE_KEY=
FLASHBOTS_AUTH_KEY=
FLASHBOTS_RPC=
BLOXROUTE_RPC=

NO_EXECUTION=true
CRYPTO_ARBITRAGE_LIVE_EXECUTION=false
CRYPTO_ARBITRAGE_LIVE_CONFIRMATION=
CRYPTO_ALLOW_PLACEHOLDER_EXECUTION=false

ZERO_CAPITAL_ENABLE_EXECUTION=false
ZERO_CAPITAL_FLASHLOAN_RECEIVER=
ZERO_CAPITAL_EXECUTION_CONFIRMATION=
ZERO_CAPITAL_ROUTE_MIN_OUTPUT_BPS=9990
ZERO_CAPITAL_MIN_PROFIT_BPS=9000
ZERO_CAPITAL_ROUTE_TTL_MS=3000
ZERO_CAPITAL_MAX_GAS_LIMIT=1500000
ZERO_CAPITAL_MAX_SLIPPAGE_BPS=20
ZERO_CAPITAL_MAX_GAS_GWEI=60
ZERO_CAPITAL_MAX_QUOTE_LATENCY_MS=1000
ZERO_CAPITAL_SIGNAL_RECHECK_MS=5000
ZERO_CAPITAL_FLASHBOTS_FEE_BUFFER_BPS=12000
ZERO_CAPITAL_FLASHBOTS_MAX_FEE_GWEI=60
ZERO_CAPITAL_FLASHBOTS_PRIORITY_FEE_GWEI=1
ZERO_CAPITAL_FLASHBOTS_MAX_PRIORITY_FEE_GWEI=3
ZERO_CAPITAL_FLASHBOTS_WAIT_TIMEOUT_MS=45000
ZERO_CAPITAL_FLASHBOTS_PAYMENT_MODE=disabled
ZERO_CAPITAL_FLASHBOTS_SPONSOR_ADDRESS=
ZERO_CAPITAL_FLASHBOTS_SPONSOR_CONFIRMATION=
ZERO_CAPITAL_ROUTE_CONFIG=[]
ZERO_CAPITAL_DEPLOY_CHAIN=
ZERO_CAPITAL_DEPLOY_RPC_URL=
ZERO_CAPITAL_DEPLOY_OWNER=
ZERO_CAPITAL_BALANCER_VAULT=
ZERO_CAPITAL_DEPLOY=false
ZERO_CAPITAL_DEPLOY_CONFIRMATION=
ZERO_CAPITAL_RECEIVER_CONFIG={"operators":[],"targets":[],"approvalTokens":[]}
ZERO_CAPITAL_CONFIGURE_RECEIVER=false
ZERO_CAPITAL_CONFIGURE_RECEIVER_CONFIRMATION=

KRAKEN_API_KEY=
KRAKEN_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# These addresses are required only for real wallet balance and withdrawal flows.
BRIDGE_WALLET_ADDRESS=
CRYPTO_PROFIT_WALLET_ADDRESS=

# ===========================================
# RAILWAY AUTO-POPULATED (Don't set manually)
# ===========================================
# RAILWAY_ENVIRONMENT=production
# RAILWAY_PROJECT_ID=auto-populated
# RAILWAY_STATIC_URL=auto-populated