# BadBlue Railway Deployment Environment Variables
# Copy this to Railway dashboard environment settings

# ===========================================
# SUPABASE CONFIGURATION (Required)
# ===========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-key-here
SUPABASE_DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Optional alternate alias for the same pooled Postgres connection string.
# SUPABASE_DB_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Do not set DATABASE_URL to https://<project>.supabase.co.
# DATABASE_URL=

# ===========================================
# MIGRATION FEATURE FLAGS
# ===========================================
# Enable these gradually during migration
USE_SUPABASE_DB=false
USE_SUPABASE_AUTH=false
USE_SUPABASE_STORAGE=false

# ===========================================
# AI SERVICE CONFIGURATION (Required)
# ===========================================
# Primary AI (50% usage)
MISTRAL_API_KEY=your-mistral-api-key

# Secondary AI (30-35% usage)
GROQ_API_KEY=your-groq-api-key

# Tertiary AI (10% usage)
GEMINI_API_KEY=your-gemini-api-key

# Quaternary AI (5-10% usage)
ANTHROPIC_API_KEY=your-anthropic-api-key

# ===========================================
# PAYMENT PROCESSING (Required by production startup)
# ===========================================
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_APPLICATION_ID=
SQUARE_ENVIRONMENT=production

# ===========================================
# EMAIL SERVICE (Required)
# ===========================================
RESEND_API_KEY=re_your-resend-api-key

# ===========================================
# PLATFORM ADMINISTRATION
# ===========================================
# Required for the PANTHEON Administrator master login. Set both only in Railway.
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=

# Optional separate admin bypass for legacy operational access.
ADMIN_BYPASS_ID=
ADMIN_BYPASS_EMAIL=
ADMIN_BYPASS_PASSWORD=

# ===========================================
# ELEVENLABS VOICE SYNTHESIS (Required for Lexara TTS)
# ===========================================
# Sign up at https://elevenlabs.io/ for API access
# IMPORTANT: Use your ElevenLabs API Key, NOT any 2FA recovery code
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-voice-id

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
NODE_ENV=production
BASE_URL=

# Generate a unique 32+ character value and set it only in Railway.
SESSION_SECRET=

# ===========================================
# CRYPTOCRAWLER MONITORING (Optional)
# ===========================================
# Use authenticated, rate-limited RPC endpoints for production monitoring.
ALCHEMY_API_KEY=
# Alchemy cost authority. Broad pending-transaction monitoring is intentionally
# disabled by default; key presence alone must never start a paid mempool firehose.
ALCHEMY_MAX_REQUESTS_PER_SECOND=4
ALCHEMY_MAX_REQUESTS_PER_MINUTE=300
ALCHEMY_DAILY_CU_BUDGET=1000000
ALCHEMY_MAX_RETRY_ATTEMPTS=2
ALCHEMY_TOKEN_BALANCE_CACHE_TTL_MS=300000
ALCHEMY_TOKEN_METADATA_CACHE_TTL_MS=86400000
ALCHEMY_MEMPOOL_MONITORING_ENABLED=false
# Required only when mempool monitoring is intentionally enabled, e.g. ethereum,polygon.
ALCHEMY_MEMPOOL_NETWORKS=
# Emergency compatibility escape hatch only. Keep false until a filtered/executable
# pending-transaction topology is intentionally accepted; true permits the legacy
# unfiltered hash stream subject to the request/CU budget governor.
ALCHEMY_ALLOW_UNFILTERED_PENDING=false
COINGECKO_API_KEY=
COINSTATS_API_KEY=
ZEROX_API_KEY=
ZEROX_TAKER_ADDRESS=
# Optional 0x route overrides/test knobs. Runtime telemetry can probe 0x without them;
# opportunity execution should derive route context dynamically from the live candidate.
ZEROX_CHAIN_ID=
ZEROX_SELL_TOKEN=
ZEROX_BUY_TOKEN=
ZEROX_SELL_AMOUNT=
# Kraken may retain an explicit configured compatibility override. Coinbase/OKX
# live execution must not treat configured fee numbers as a substitute for their
# authenticated fee/instrument evidence.
CRYPTO_ARBITRAGE_COINBASE_TAKER_FEE_BPS=
CRYPTO_ARBITRAGE_KRAKEN_TAKER_FEE_BPS=
CRYPTO_ARBITRAGE_OKX_TAKER_FEE_BPS=

# Broad measured discovery. Public-venue snapshots are batched, while authenticated
# executable evaluation remains bounded by the private CEX worker pool.
CRYPTO_MARKET_UNIVERSE_SIZE=120
CRYPTO_ARBITRAGE_MIN_SYMBOLS=12
CRYPTO_ARBITRAGE_BASE_SYMBOLS=24
CRYPTO_ARBITRAGE_MAX_SYMBOLS=96
CRYPTO_ARBITRAGE_SCAN_CONCURRENCY=6
CRYPTOCRAWL_SCAN_INTERVAL_MIN_MS=2000
CRYPTOCRAWL_SCAN_INTERVAL_BASE_MS=5000
CRYPTOCRAWL_SCAN_INTERVAL_MAX_MS=15000
CRYPTO_REQUIRE_LIVE_CONNECTORS=true
CRYPTARA_REQUIRE_LIVE_SIGNALS=true
ALCHEMY_REQUIRE_LIVE=true
TRADINGVIEW_LIVE_ENABLED=true

ETHEREUM_RPC_URL=
POLYGON_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
BSC_RPC_URL=
AVALANCHE_RPC_URL=

# Optional explicit Ankr endpoints. Configured endpoints may be admitted normally.
# Anonymous public Ankr fallback is fail-closed by default and must be explicitly
# enabled with CRYPTOCRAWL_ALLOW_PUBLIC_ANKR_FALLBACK=true when intentionally used.
ETHEREUM_ANKR_RPC_URL=
POLYGON_ANKR_RPC_URL=
ARBITRUM_ANKR_RPC_URL=
OPTIMISM_ANKR_RPC_URL=
BASE_ANKR_RPC_URL=
BSC_ANKR_RPC_URL=
AVALANCHE_ANKR_RPC_URL=
CRYPTOCRAWL_ALLOW_PUBLIC_ANKR_FALLBACK=false

PRIVATE_RPC_URL=
RPC_URL=
# Canonical operational CryptoCrawler signer. Its EVM address is derived at runtime
# and is reused for bridge depositor/recipient identity and retained trading profits.
WALLET_PRIVATE_KEY=
FLASHBOTS_AUTH_KEY=
FLASHBOTS_RPC=
BLOXROUTE_RPC=

# Normal authorized production posture: leave the emergency master stop disabled.
# RiskGovernor, Cryptara, verified all-in economics, circuit breakers and settlement
# verification remain responsible for rejecting unsafe/negative candidates.
NO_EXECUTION=false
CRYPTO_ARBITRAGE_LIVE_EXECUTION=false
CRYPTO_ARBITRAGE_LIVE_CONFIRMATION=
CRYPTO_ALLOW_PLACEHOLDER_EXECUTION=false

ZERO_CAPITAL_ENABLE_EXECUTION=false
ZERO_CAPITAL_FLASHLOAN_RECEIVER=
ZERO_CAPITAL_EXECUTION_CONFIRMATION=
ZERO_CAPITAL_ROUTE_MIN_OUTPUT_BPS=9990
ZERO_CAPITAL_MIN_PROFIT_BPS=9000
ZERO_CAPITAL_ROUTE_TTL_MS=3000
ZERO_CAPITAL_MAX_GAS_LIMIT=1500000
ZERO_CAPITAL_MAX_SLIPPAGE_BPS=20
ZERO_CAPITAL_MAX_GAS_GWEI=60
ZERO_CAPITAL_MAX_QUOTE_LATENCY_MS=1000
ZERO_CAPITAL_SIGNAL_RECHECK_MS=5000
ZERO_CAPITAL_FLASHBOTS_FEE_BUFFER_BPS=12000
ZERO_CAPITAL_FLASHBOTS_MAX_FEE_GWEI=60
ZERO_CAPITAL_FLASHBOTS_PRIORITY_FEE_GWEI=1
ZERO_CAPITAL_FLASHBOTS_MAX_PRIORITY_FEE_GWEI=3
ZERO_CAPITAL_FLASHBOTS_WAIT_TIMEOUT_MS=45000
ZERO_CAPITAL_FLASHBOTS_PAYMENT_MODE=disabled
ZERO_CAPITAL_FLASHBOTS_SPONSOR_ADDRESS=
ZERO_CAPITAL_FLASHBOTS_SPONSOR_CONFIRMATION=
ZERO_CAPITAL_ROUTE_CONFIG=[]
ZERO_CAPITAL_DEPLOY_CHAIN=
ZERO_CAPITAL_DEPLOY_RPC_URL=
ZERO_CAPITAL_DEPLOY_OWNER=
ZERO_CAPITAL_BALANCER_VAULT=
ZERO_CAPITAL_DEPLOY=false
ZERO_CAPITAL_DEPLOY_CONFIRMATION=
ZERO_CAPITAL_RECEIVER_CONFIG={"operators":[],"targets":[],"approvalTokens":[]}
ZERO_CAPITAL_CONFIGURE_RECEIVER=false
ZERO_CAPITAL_CONFIGURE_RECEIVER_CONFIRMATION=

KRAKEN_API_KEY=
KRAKEN_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Coinbase Advanced Trade / CDP. The API key name is normally the full
# organizations/{org_id}/apiKeys/{key_id} identifier. Railway may store a PEM
# private key on one line with literal \n escapes; runtime normalizes them.
# Coinbase taker/IOC capability is implemented through Advanced Trade, but live
# execution remains fail-closed unless authenticated canView/canTrade permissions,
# authenticated SPOT fee evidence, measured product constraints/depth, reconciled
# inventory, settlement verification, governance, and live confirmation all pass.
COINBASE_API_KEY=
COINBASE_API_SECRET=

# Final external wallet used only when the independent terminal treasury sweeper
# cashes out after a verified terminal shutdown. Normal runtime profits do NOT go here.
CRYPTO_PROFIT_WALLET_ADDRESS=

# Legacy compatibility only. Do not configure these for a new deployment.
# If BRIDGE_WALLET_ADDRESS is retained, it MUST equal the address derived from
# WALLET_PRIVATE_KEY. Runtime auto-populates the bridge/Across depositor aliases
# from WALLET_PRIVATE_KEY when they are absent and fails closed on a mismatch.
# BRIDGE_WALLET_ADDRESS=
# CRYPTOCRAWL_ACROSS_DEPOSITOR_ADDRESS=
# BRIDGE_SIGNER_PRIVATE_KEY=  # deprecated duplicate signer; remove from Railway
# WALLET_PUBLIC_KEY=          # unused/deprecated; remove from Railway

# ===========================================
# RAILWAY AUTO-POPULATED (Don't set manually)
# ===========================================
# RAILWAY_ENVIRONMENT=production
# RAILWAY_PROJECT_ID=auto-populated
# RAILWAY_STATIC_URL=auto-populated
