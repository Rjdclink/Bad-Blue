{
  "domain": "probate-estate-law",
  "name": "Probate and Estate Law",
  "theme": {
    "primaryColor": "#8DA399",
    "secondaryColor": "#8DA39988",
    "accentColor": "#D4AF37",
    "backgroundColor": "#1a1a2e",
    "textColor": "#ffffff"
  },
  "layout": {
    "consultationForm": {
      "title": "Probate and Estate Law Consultation",
      "subtitle": "Wills, estates, inheritance, probate court",
      "fields": [
        {
          "id": "issue_type",
          "label": "Type of Issue",
          "type": "select",
          "options": ["General Inquiry", "Document Review", "Case Evaluation", "Legal Research", "Other"],
          "required": true
        },
        {
          "id": "description",
          "label": "Describe Your Situation",
          "type": "textarea",
          "placeholder": "Provide details about your Probate and Estate Law issue...",
          "required": true
        },
        {
          "id": "deadline",
          "label": "Any Upcoming Deadlines?",
          "type": "date",
          "required": false
        }
      ]
    },
    "resultsDisplay": {
      "showCitations": true,
      "showTemplates": true,
      "showConfidence": true,
      "showSuggestedActions": true
    }
  },
  "features": {
    "voiceInput": true,
    "documentGeneration": true,
    "templateLibrary": true,
    "caseResearch": true,
    "statuteLookup": true
  },
  "accessibility": {
    "highContrast": true,
    "screenReaderOptimized": true,
    "textToSpeech": true,
    "fontSize": "adjustable"
  }
}
