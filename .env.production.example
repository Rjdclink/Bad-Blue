# Production Environment Configuration Example
# Copy to .env and configure for production deployment

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://user:password@host:5432/database
# OR use Supabase:
# SUPABASE_DATABASE_URL=postgresql://postgres:[PASSWORD]@[PROJECT].supabase.co:5432/postgres

# ============================================
# INMATE SEARCH CONFIGURATION
# ============================================
# BOP (Bureau of Prisons) - Federal inmate search (PUBLIC API)
INMATE_ENABLE_BOP=true  # Must be true 

# State DOC (Department of Corrections) - IMPLEMENTED
# Set to true 
INMATE_ENABLE_STATE_DOC=true

# VINE (Victim Information Notification) - IMPLEMENTED  
# VINELink integration is configured
INMATE_ENABLE_VINE=true

# ============================================
# PEOPLE SEARCH CONFIGURATION
# ============================================
# Browser automation (required)
PEOPLE_SEARCH_BROWSER_POOL_SIZE=3
PEOPLE_SEARCH_MAX_RETRIES=3
PEOPLE_SEARCH_TIMEOUT=30000

# Data sources (at least one must be enabled)
PEOPLE_SEARCH_ENABLE_FPS=true   # FastPeopleSearch
PEOPLE_SEARCH_ENABLE_TPS=true   # TruePeopleSearch
PEOPLE_SEARCH_ENABLE_WP=true    # WhitePages

# Caching (highly recommended for production)
PEOPLE_SEARCH_DISABLE_CACHE=false
PEOPLE_SEARCH_CACHE_TTL=3600000  # 1 hour in milliseconds

# Optional features
PEOPLE_SEARCH_ENABLE_SOCIAL=true   # Social media intelligence
PEOPLE_SEARCH_ENABLE_EMAIL=true    # Email discovery

# ============================================
# PANTHEON CONFIGURATION
# ============================================
# Resource management (optimized for free-tier: 0.25 vCPU, 256MB RAM)
PANTHEON_CPU_THRESHOLD=30        # Activate only if CPU < 30% (range: 10-90)
PANTHEON_MEM_THRESHOLD=70        # Hibernate if memory > 70% (range: 50-95)

# Quantum execution
PANTHEON_QUANTUM_SLICE=50        # Work chunk duration ms (range: 10-1000)
PANTHEON_SLEEP_BETWEEN=10        # Cooldown between chunks ms (range: 0-100)

# Stealth and rate limiting (recommended: enabled)
PANTHEON_STEALTH_MODE=true       # Zero-trace ghost protocol
PANTHEON_RATE_LIMIT=true         # Prevent upstream blocking
PANTHEON_REQUEST_DELAY_MS=1000   # Min delay between requests

# Warp speed settings
PANTHEON_WARP_ENABLED=true       # Enable warp speed mode
PANTHEON_MAX_WARP_FACTOR=10      # Max speed multiplier (range: 1-20)
PANTHEON_PARALLEL_BATCH_SIZE=5   # Parallel task batch size

# Entropy management
PANTHEON_ENTROPY_BUDGET=100      # Max entropy signatures per task (range: 1-10000)
PANTHEON_COMPRESSION_RATIO=0.1   # Solution space compression (top 10%)

# ============================================
# API KEYS (External Services)
# ============================================
# AI Providers (at least one recommended)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Firecrawl (optional, for enhanced web scraping)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# SerpAPI (optional, for search intelligence)
SERPAPI_API_KEY=your_serpapi_api_key_here

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
SESSION_SECRET=generate_a_secure_random_string_here

# PANTHEON Administrator master login. Configure both values only in deployment secrets.
MASTER_ADMIN_EMAIL=
MASTER_ADMIN_PASSWORD=

# Internal API keys (for service-to-service auth)
INTERNAL_KEY=generate_a_secure_internal_key_here
INTERNAL_VERIFY_SECRET=generate_another_secure_key_here

# ============================================
# PAYMENT PROCESSING
# ============================================
# Square (primary)
SQUARE_ACCESS_TOKEN=your_square_access_token_here
SQUARE_LOCATION_ID=your_square_location_id_here

# ============================================
# EMAIL SERVICE
# ============================================
# Mailgun
RESEND_API_KEY=your_resend_api_key_here
RESEND_PORT=your_resend_port_here



# ============================================
# APPLICATION SETTINGS
# ============================================
NODE_ENV=production
PORT=5000
BASE_URL=https://your-domain.com

# ============================================
# CRYPTOCURRENCY (CryptoCrawl)
# ============================================
# Only needed if using crypto features
BEAM_ENABLED=true
INTERNAL_API_KEY=same_as_internal_key_above

# ============================================
# DEPLOYMENT
# ============================================
# Railway (if using Railway)
# RAILWAY_SERVICE_NAME=legalwhat-prod
# RAILWAY_GIT_COMMIT_SHA=auto_populated_by_railway

# ============================================
# MONITORING & LOGGING
# ============================================
LOG_LEVEL=info  # debug, info, warn, error
ENABLE_REQUEST_LOGGING=true

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100  # Max requests per window

# ============================================
# NOTES
# ============================================
# 1. Never commit this file with real credentials
# 2. Use strong, unique values for all secrets
# 3. Rotate keys regularly in production
# 4. Monitor logs for configuration warnings
# 5. Test configuration with /api/health endpoint
