# BadBlue Environment Variables Template
# Copy this file to .env and fill in your actual values

# ═══════════════════════════════════════════════════════
# DATABASE CONFIGURATION (PostgreSQL) - REQUIRED
# ═══════════════════════════════════════════════════════

DATABASE_URL=postgresql://user:password@host:5432/database
PGHOST=your-db-host.example.com
PGPORT=5432
PGUSER=your_db_user
PGPASSWORD=your_db_password
PGDATABASE=your_database_name

# ═══════════════════════════════════════════════════════
# AI SERVICE API KEYS - REQUIRED
# ═══════════════════════════════════════════════════════

# Primary AI Providers (AUTONOMOUS context: Groq + Mistral)
GROQ_API_KEY=your-groq-api-key
MISTRAL_API_KEY=your-mistral-api-key

# User-facing AI Providers (USER context: Gemini + Claude + OpenRouter)
GEMINI_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenRouter API Key - Enables DeepSeek, Grok, and Kimi models (50 RPD each)
# Sign up at https://openrouter.ai/ for free tier access
# Models available:
#   - DeepSeek R1T2 Chimera (671B params, strong reasoning)
#   - Grok 4.1 Fast (2M context, multimodal)
#   - Kimi K2 (1T params, structured extraction)
OPENROUTER_API_KEY=your-openrouter-api-key

# ═══════════════════════════════════════════════════════
# DEPRECATED - REMOVED
# ═══════════════════════════════════════════════════════
# BING_API_KEY - No longer used (HTTP 402 payment required)
# Web search now uses Gemini grounding + OpenRouter models

# ═══════════════════════════════════════════════════════
# SQUARE PAYMENT CONFIGURATION - REQUIRED
# ═══════════════════════════════════════════════════════

SQUARE_ACCESS_TOKEN=your_production_access_token
SQUARE_APPLICATION_ID=sq0idp-n5aXRG01aPrZ4KqxIh33Sw
SQUARE_LOCATION_ID=L0DRZCZ8YRK5K
SQUARE_ENVIRONMENT=production
SQUARE_WEBHOOK_SIGNATURE_KEY=your_webhook_signature_key
VITE_SQUARE_APPLICATION_ID=sq0idp-n5aXRG01aPrZ4KqxIh33Sw
VITE_SQUARE_LOCATION_ID=L0DRZCZ8YRK5K
VITE_SQUARE_ENVIRONMENT=production

# ═══════════════════════════════════════════════════════
# EMAIL CONFIGURATION (SMTP) - REQUIRED
# ═══════════════════════════════════════════════════════

GWSMTP_USER=your-email@example.com
GWSMTP_PASS=your-email-password

# ═══════════════════════════════════════════════════════
# SESSION MANAGEMENT - REQUIRED
# ═══════════════════════════════════════════════════════

SESSION_SECRET=generate-a-long-random-string-here

# ═══════════════════════════════════════════════════════
# OBJECT STORAGE CONFIGURATION - OPTIONAL (Replit Only)
# ═══════════════════════════════════════════════════════
#
# These variables are ONLY needed if running on Replit with Object Storage.
# When migrating off Replit, leave these commented out or unset.
# The app will work without object storage - data persists in PostgreSQL.
#
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=your-bucket-id
# PUBLIC_OBJECT_SEARCH_PATHS=/path/to/public
# PRIVATE_OBJECT_DIR=/path/to/private

# ═══════════════════════════════════════════════════════
# ADDITIONAL DATABASES - OPTIONAL
# ═══════════════════════════════════════════════════════

SUPABASE_DATABASE_URL=postgresql://user:password@host:5432/database

# ═══════════════════════════════════════════════════════
# REPLIT OAUTH CONFIGURATION - OPTIONAL
# ═══════════════════════════════════════════════════════
#
# These variables are ONLY needed if running on Replit platform.
# When migrating off Replit, leave these commented out.
# The app will automatically use local authentication instead.
#
# REPLIT_DOMAINS=your-repl-domain.repl.co
# REPL_ID=your-repl-id
# ISSUER_URL=https://replit.com/oidc

# ═══════════════════════════════════════════════════════
# DEPLOYMENT CONFIGURATION - PLATFORM-AGNOSTIC
# ═══════════════════════════════════════════════════════

NODE_ENV=production

# Port Configuration (Optional - auto-detects on most platforms)
# Railway, Heroku, etc. set this automatically. Default: 5000
# PORT=5000

# Base URL (REQUIRED for custom domains)
# Used for email links, Stripe redirects, and SEO metadata
# Set this for production deployments with custom domains
BASE_URL=https://bad-blue.com

# Frontend Base URL (Optional - for custom domain frontend)
# Only needed if frontend is hosted separately from backend
# VITE_BASE_URL=https://yourdomain.com

# AI Token Governor Settings
AUTONOMOUS_GROQ_LIMIT_PERCENT=35

# Autonomous Function Controls
SUBAGENT_ENABLE_OFFICER_SEARCH=false
SUBAGENT_ENABLE_DAILY_SCRAPE=false
SUBAGENT_ENABLE_SELF_IMPROVEMENT=false
AI_REMEDIATION_ENABLED=false