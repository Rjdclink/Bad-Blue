# BadBlue Environment Variables Template
# Copy this file to .env and fill in your actual values

# ═══════════════════════════════════════════════════════
# DATABASE CONFIGURATION (Supabase Postgres) - REQUIRED
# ═══════════════════════════════════════════════════════

SUPABASE_DATABASE_URL=postgresql://user:password@host:5432/database

# Optional alternate name for the same Supabase Postgres connection string
# SUPABASE_DB_URL=postgresql://user:password@host:5432/database

# Local-only fallback. Do not point this at a Replit-era internal database.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Supabase project URL for API/client usage only. Never use this as DATABASE_URL.
# SUPABASE_URL=https://your-project.supabase.co

PGHOST=your-db-host.example.com
PGPORT=5432
PGUSER=your_db_user
PGPASSWORD=your_db_password
PGDATABASE=your_database_name

# ═══════════════════════════════════════════════════════
# AI SERVICE API KEYS - REQUIRED
# ═══════════════════════════════════════════════════════

# Primary AI Providers (AUTONOMOUS context: Groq + Mistral)
GROQ_API_KEY=your-groq-api-key
MISTRAL_API_KEY=your-mistral-api-key

# User-facing AI Providers (USER context: Gemini + Claude + OpenRouter)
GEMINI_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenRouter API Key - Enables DeepSeek, Grok, and Kimi models (50 RPD each)
# Sign up at https://openrouter.ai/ for free tier access
# Models available:
#   - DeepSeek R1T2 Chimera (671B params, strong reasoning)
#   - Grok 4.1 Fast (2M context, multimodal)
#   - Kimi K2 (1T params, structured extraction)
OPENROUTER_API_KEY=your-openrouter-api-key

# ═══════════════════════════════════════════════════════
# ELEVENLABS VOICE SYNTHESIS - REQUIRED FOR LEXARA TTS
# ═══════════════════════════════════════════════════════

# ElevenLabs API Key (REQUIRED)
# Sign up at https://elevenlabs.io/ for API access
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
# IMPORTANT: Use your ElevenLabs API Key, NOT any 2FA recovery code
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# ElevenLabs Voice ID (REQUIRED)
# Get voice IDs from: https://elevenlabs.io/app/voice-library
# Or use the API: https://api.elevenlabs.io/v1/voices
# Recommended voices for Lexara (young female with authority):
#   - "Rachel" (21yo American)
#   - "Charlotte" (young British)
#   - Clone a custom voice for best results
ELEVENLABS_VOICE_ID=your-voice-id

