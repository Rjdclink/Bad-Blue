# ═══════════════════════════════════════════════════════
# EMAIL CONFIGURATION (Gmail SMTP) - REQUIRED
# ═══════════════════════════════════════════════════════

# Gmail SMTP Configuration
GWSMTP_USER=your-email@gmail.com

# IMPORTANT: Use Gmail App Password, NOT your regular account password
# Regular Gmail passwords will NOT work due to security settings
# 
# How to generate a Gmail App Password:
# 1. Go to: https://myaccount.google.com/apppasswords
# 2. Sign in to your Google account
# 3. Enable 2-Factor Authentication if not already enabled (required)
# 4. Create a new app password (select "Mail" and "Other device")
# 5. Copy the 16-character password (without spaces)
# 6. Paste it below
#
# Note: If you see "App passwords not available", you need to:
# - Enable 2-Factor Authentication first
# - If using Google Workspace, your admin must allow app passwords
GWSMTP_PASS=your-16-char-app-password

# ═══════════════════════════════════════════════════════
# SESSION MANAGEMENT - REQUIRED
# ═══════════════════════════════════════════════════════

# REQUIRED: generate a random 32+ char secret (example: `openssl rand -hex 32`)
SESSION_SECRET=

# ═══════════════════════════════════════════════════════
# ADMIN CREDENTIALS - OPTIONAL (For Admin Bypass)
# ═══════════════════════════════════════════════════════

# Admin bypass credentials for direct admin access
# Leave these empty to disable admin bypass
ADMIN_BYPASS_EMAIL=
ADMIN_BYPASS_PASSWORD=
ADMIN_BYPASS_FIRST_NAME=Admin
ADMIN_BYPASS_LAST_NAME=User

# ═══════════════════════════════════════════════════════
# OBJECT STORAGE CONFIGURATION - OPTIONAL (Replit Only)
# ═══════════════════════════════════════════════════════
#
# These variables are ONLY needed if running on Replit with Object Storage.
# When migrating off Replit, leave these commented out or unset.
# The app will work without object storage - data persists in PostgreSQL.
#
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=your-bucket-id
# PUBLIC_OBJECT_SEARCH_PATHS=/path/to/public
# PRIVATE_OBJECT_DIR=/path/to/private

# ═══════════════════════════════════════════════════════
# ADDITIONAL DATABASE ALIAS - OPTIONAL
# ═══════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════
# REPLIT OAUTH CONFIGURATION - OPTIONAL
# ═══════════════════════════════════════════════════════
#
# These variables are ONLY needed if running on Replit platform.
# When migrating off Replit, leave these commented out.
# The app will automatically use local authentication instead.
#
# REPLIT_DOMAINS=your-repl-domain.repl.co
# REPL_ID=your-repl-id
# ISSUER_URL=https://replit.com/oidc

# ═══════════════════════════════════════════════════════
# DEPLOYMENT CONFIGURATION - PLATFORM-AGNOSTIC
# ═══════════════════════════════════════════════════════

NODE_ENV=production

# Port Configuration (Optional - auto-detects on most platforms)
# Railway, Heroku, etc. set this automatically. Default: 5000
# PORT=5000

# Base URL (REQUIRED for custom domains)
# Used for email links, Stripe redirects, and SEO metadata
# Set this for production deployments with custom domains
BASE_URL=https://example.com

# Frontend Base URL (Optional - for custom domain frontend)
# Only needed if frontend is hosted separately from backend
# VITE_BASE_URL=https://yourdomain.com

# AI Token Governor Settings
AUTONOMOUS_GROQ_LIMIT_PERCENT=35

# Autonomous Function Controls
SUBAGENT_ENABLE_OFFICER_SEARCH=false
SUBAGENT_ENABLE_DAILY_SCRAPE=false
SUBAGENT_ENABLE_SELF_IMPROVEMENT=false
AI_REMEDIATION_ENABLED=false

# ═══════════════════════════════════════════════════════
# REDIS CACHE - OPTIONAL
# ═══════════════════════════════════════════════════════

# Redis Cache (optional - falls back to memory-only)
REDIS_URL=redis://localhost:6379

# ═══════════════════════════════════════════════════════
# OSINT TOOLS - OPTIONAL
# ═══════════════════════════════════════════════════════

# SpiderFoot (self-hosted, free)
SPIDERFOOT_URL=http://localhost:5001

# Hunter.io (50 free searches/month)
HUNTER_API_KEY=

# HaveIBeenPwned (free, API key increases rate limit)
HIBP_API_KEY=

# ═══════════════════════════════════════════════════════
# PEOPLE SEARCH BROWSER CONFIGURATION - OPTIONAL
# ═══════════════════════════════════════════════════════

# Remote Browser Connection (Optional - Tier 2)
# People Search operates in tiered extraction modes:
#   - Tier 0 (default): HTTP-only fetch/extract pipeline with no browser
#   - Tier 1 (on demand): Remote-render via ZenRows API (JS-heavy pages)
#   - Tier 2 (boxed): Remote browser via CDP WebSocket (advanced, disabled by default)
#
# Tier 1: ZenRows API Key for remote JavaScript rendering
# Sign up at https://www.zenrows.com/ for API access
# Free tier: 1,000 requests/month
# Used automatically when Tier 0 detects JS-heavy pages
ZENROWS_API_KEY=

# Tier 2: Set BROWSER_WS_ENDPOINT to enable CDP browser mode (disabled by default)
# This should point to a remote browser instance's Chrome DevTools Protocol WebSocket endpoint.
# 
# Example remote browser services:
#   - Browserless.io: wss://chrome.browserless.io?token=YOUR_TOKEN
#   - BrowserStack: wss://YOUR_ID:YOUR_KEY@hub-cloud.browserstack.com/wd/hub
#   - Self-hosted: wss://your-browser-service.com/devtools/browser/BROWSER_ID
#
# When not set, People Search uses Tier 0 (HTTP) → Tier 1 (ZenRows) pipeline.
# BROWSER_WS_ENDPOINT=

# ═══════════════════════════════════════════════════════
# SHADOW RETRIEVAL ENGINE - OPTIONAL
# ═══════════════════════════════════════════════════════

# Firecrawl API Key (Premium scraping service)
# Sign up at https://www.firecrawl.dev/ for API access
FIRECRAWL_API_KEY=

# Shadow Retrieval Configuration
SHADOW_RETRIEVAL_ENABLED=true
MAX_CONCURRENT_RETRIEVALS=10

# ═══════════════════════════════════════════════════════
# CRYPTOCRAWL / CRYPTARA CONNECTORS - OPTIONAL IN DEV, REQUIRED FOR LIVE
# ═══════════════════════════════════════════════════════

# Live blockchain telemetry and mempool monitoring
ALCHEMY_API_KEY=

# Require live TradingView + Alchemy connectors for startup/readiness checks
CRYPTO_REQUIRE_LIVE_CONNECTORS=false
CRYPTARA_REQUIRE_LIVE_SIGNALS=false
ALCHEMY_REQUIRE_LIVE=false
TRADINGVIEW_LIVE_ENABLED=true
CRYPTOCRAWL_CAPITAL_USD=0

# Primary RPCs for realtime stream and transaction submission
PRIVATE_RPC_URL=
RPC_URL=
ETHEREUM_RPC_URL=
POLYGON_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
BASE_RPC_URL=

# Transaction signing / relays for live execution
WALLET_PRIVATE_KEY=
FLASHBOTS_AUTH_KEY=
FLASHBOTS_RPC=
BLOXROUTE_RPC=

# Live execution safety interlocks
NO_EXECUTION=true
CRYPTO_ARBITRAGE_LIVE_EXECUTION=false
CRYPTO_ARBITRAGE_LIVE_CONFIRMATION=
CRYPTO_ALLOW_PLACEHOLDER_EXECUTION=false

# Zero-capital execution requires a deployed flash-loan receiver contract.
ZERO_CAPITAL_ENABLE_EXECUTION=false
ZERO_CAPITAL_FLASHLOAN_RECEIVER=
ZERO_CAPITAL_EXECUTION_CONFIRMATION=
ZERO_CAPITAL_ROUTE_MIN_OUTPUT_BPS=9990
ZERO_CAPITAL_MIN_PROFIT_BPS=9000
ZERO_CAPITAL_ROUTE_TTL_MS=3000
ZERO_CAPITAL_MAX_GAS_LIMIT=1500000
ZERO_CAPITAL_MAX_SLIPPAGE_BPS=20
ZERO_CAPITAL_MAX_GAS_GWEI=60
ZERO_CAPITAL_MAX_QUOTE_LATENCY_MS=1000
ZERO_CAPITAL_SIGNAL_RECHECK_MS=5000
ZERO_CAPITAL_FLASHBOTS_FEE_BUFFER_BPS=12000
ZERO_CAPITAL_FLASHBOTS_MAX_FEE_GWEI=60
ZERO_CAPITAL_FLASHBOTS_PRIORITY_FEE_GWEI=1
ZERO_CAPITAL_FLASHBOTS_MAX_PRIORITY_FEE_GWEI=3
ZERO_CAPITAL_FLASHBOTS_WAIT_TIMEOUT_MS=45000
ZERO_CAPITAL_FLASHBOTS_PAYMENT_MODE=disabled
ZERO_CAPITAL_FLASHBOTS_SPONSOR_ADDRESS=
ZERO_CAPITAL_FLASHBOTS_SPONSOR_CONFIRMATION=
ZERO_CAPITAL_ROUTE_CONFIG=[]
ZERO_CAPITAL_DEPLOY_CHAIN=
ZERO_CAPITAL_DEPLOY_RPC_URL=
ZERO_CAPITAL_DEPLOY_OWNER=
ZERO_CAPITAL_BALANCER_VAULT=
ZERO_CAPITAL_DEPLOY=false
ZERO_CAPITAL_DEPLOY_CONFIRMATION=
ZERO_CAPITAL_RECEIVER_CONFIG={"operators":[],"targets":[],"approvalTokens":[]}
ZERO_CAPITAL_CONFIGURE_RECEIVER=false
ZERO_CAPITAL_CONFIGURE_RECEIVER_CONFIRMATION=

# Optional centralized exchange routing
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# ═══════════════════════════════════════════════════════
# Shadow Retrieval - Puppeteer Configuration
# ═══════════════════════════════════════════════════════

# Puppeteer headless mode (true/false)
PUPPETEER_HEADLESS=true

# Custom Chromium executable path (optional, auto-detected on Railway)
# On Railway, the system will automatically detect available Chromium paths:
#   - /usr/bin/chromium-browser
#   - /usr/bin/chromium
#   - /usr/bin/google-chrome-stable
# Set this only if you need to override auto-detection
PUPPETEER_EXECUTABLE_PATH=

# ═══════════════════════════════════════════════════════
# APIFY + PROXY-CHAIN CONFIGURATION - OPTIONAL
# ═══════════════════════════════════════════════════════

# Optional: Apify token for residential/datacenter proxies
# Sign up at https://apify.com/ for API access
APIFY_TOKEN=

# Optional: Custom proxy list (comma-separated)
# Example: http://proxy1:8080,http://proxy2:8080
CUSTOM_PROXIES=

# Proxy rotation mode: round-robin | random | session-based
PROXY_ROTATION_MODE=session-based

# Session persistence (requests per session)
PROXY_SESSION_PERSISTENCE=100

# ═══════════════════════════════════════════════════════
# STEALTH INFRASTRUCTURE (PANTHEON) - OPTIONAL
# ═══════════════════════════════════════════════════════

# Tor multi-instance configuration
TOR_ENABLED=true
TOR_DATA_DIR=/var/lib/tor-stealth

# VPN configuration (optional - for free VPN providers)
PROTONVPN_USERNAME=
PROTONVPN_PASSWORD=
WINDSCRIBE_USERNAME=
WINDSCRIBE_PASSWORD=

# Cloudflare Worker proxies (optional)
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# ═══════════════════════════════════════════════════════
# CLOUDFLARE KV (PANTHEON PHYLACTERY SYSTEM) - OPTIONAL
# ═══════════════════════════════════════════════════════

# Cloudflare KV Configuration for PANTHEON distributed storage
# Sign up at https://dash.cloudflare.com/ for free KV storage
# Free tier: 100,000 reads/day, 1,000 writes/day, 1GB storage
CLOUDFLARE_KV_NAMESPACES={"phylactery":"namespace_id_1","hive_mind":"namespace_id_2","underworld":"namespace_id_3","ice_crystals":"namespace_id_4"}

# ═══════════════════════════════════════════════════════
# BLOCKCHAIN API SERVICES (ALCHEMY + ETHERSCAN)
# ═══════════════════════════════════════════════════════

# Alchemy API - Primary blockchain access layer
# Sign up at https://www.alchemy.com/ for API access
# Free tier: 300M compute units/month, 25 requests/second
ALCHEMY_API_KEY=your-alchemy-api-key

# Etherscan API - Blockchain data layer
# Sign up at https://etherscan.io/apis for API access
# Free tier: 5 calls/second, 100,000 calls/day
ETHERSCAN_API_KEY=your-etherscan-api-key

# Eden Region for latency optimization
# Options: us-east-1, us-west-2, eu-central-1, eu-west-2, ap-northeast-1, ap-southeast-1
EDEN_REGION=us-east-1

# Chain-specific RPC URLs (optional - uses Alchemy if not set)
POLYGON_RPC_URL=
ARBITRUM_RPC_URL=
AVALANCHE_RPC_URL=
BSC_RPC_URL=
OPTIMISM_RPC_URL=

# WebSocket endpoints for real-time data (optional)
POLYGON_WS_URL=
ARBITRUM_WS_URL=
AVALANCHE_WS_URL=
BSC_WS_URL=
OPTIMISM_WS_URL=

