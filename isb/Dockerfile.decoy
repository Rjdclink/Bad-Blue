# A separate decoy ONLY. This image intentionally excludes Railway CLI and tokens.
FROM node:22-bookworm-slim AS verify
WORKDIR /opt/isb
COPY *.cjs ./
COPY Dockerfile Dockerfile.decoy ./
COPY collect.sh ./
RUN node --test *.test.cjs

FROM node:22-bookworm-slim
WORKDIR /opt/isb
COPY observer.cjs bubbles.cjs decoy.cjs run-decoy.cjs ./
ENV NODE_ENV=production
USER node
EXPOSE 8080
CMD ["node", "run-decoy.cjs"]
